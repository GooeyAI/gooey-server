{
  "include": ["remix.env.d.ts", "**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2019"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "target": "ES2019",
    "strict": true,
    "allowJs": true,
    // Dependencies' own .d.ts files are not ours to fix, and checking them buried the five
    // real errors in this app under nine from `@remix-run/node`, `@types/glob` and friends.
    // `npm run typecheck` reports on our code now.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@gooey-types/*": ["../gooey_gui/types/*"]
    },
    "module": "CommonJS",

    // Remix takes care of building everything in `remix build`.
    "noEmit": true
  }
}
